# Copia este archivo como `.env` y rellena tus claves de EmailJS.
# (Vite expone al frontend solo las variables que empiezan por VITE_.)

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Google AdSense: crea una unidad de anuncio en tu panel de AdSense y pega
# aquí su "data-ad-slot". Sin este valor, los anuncios simplemente no se muestran.
VITE_ADSENSE_SLOT=your_ad_slot_id
